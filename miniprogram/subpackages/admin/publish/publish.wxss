.form-card,
.preview-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #9c2f22;
  margin: 20rpx 0 16rpx;
}

.form-title:first-child {
  margin-top: 0;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: #8b8172;
  margin-bottom: 8rpx;
}

.field-input,
.picker {
  background: #faf6ec;
  border: 1rpx solid #e7dcc4;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.field-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 130rpx;
  background: #faf6ec;
  border: 1rpx solid #e7dcc4;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.ai-btn {
  width: 100%;
  background: linear-gradient(135deg, #8e2a20, #c9a227);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.ai-btn[disabled] {
  background: #c3cbe0;
  color: #ffffff;
}

.ai-tip {
  font-size: 20rpx;
  color: #a39a8b;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

.half {
  flex: 1;
  width: auto;
}

.human-text {
  font-size: 26rpx;
  color: #2d2926;
  line-height: 1.7;
  background: #e9f3ee;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 20rpx;
}

.spec-box {
  max-height: 360rpx;
  background: #2d2926;
  border-radius: 12rpx;
  padding: 18rpx;
}

.spec-text {
  font-size: 22rpx;
  color: #a5f3fc;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.preview-btn {
  background: #faf0d7;
  color: #9c2f22;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.publish-btn {
  background: #9c2f22;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}
