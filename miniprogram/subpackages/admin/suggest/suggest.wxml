<view class="container">
  <view class="card input-card">
    <view class="input-title">选择时间范围与分类，AI 自动生成候选事件</view>
    <view class="pick-row">
      <view class="pick-item">
        <text class="pick-label">时间</text>
        <picker mode="selector" range="{{timeRanges}}" value="{{timeRangeIndex}}" bindchange="onTimeRange">
          <view class="pick-box">📅 {{timeRanges[timeRangeIndex]}}</view>
        </picker>
      </view>
      <view class="pick-item">
        <text class="pick-label">分类</text>
        <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
          <view class="pick-box">🏷 {{categories[categoryIndex]}}</view>
        </picker>
      </view>
    </view>
    <button class="gen-btn" bindtap="onGenerate" disabled="{{generating}}">
      {{generating ? '生成中...' : '🤖 AI 生成候选事件'}}
    </button>
    <view class="gen-tip">AI 只做选题建议，请勾选“可验证”的候选并核对数据源后再发题。联网检索 + 生成约需 30–90 秒，请耐心等待。</view>
  </view>

  <!-- 定时候选：dailyHotTopics 每天 08:00/20:00 自动生成 -->
  <view class="card auto-card">
    <view class="input-title">📥 定时候选（每日自动生成）</view>
    <view class="auto-tip">系统每天自动聚合 GitHub / Hacker News / IT之家 / 36氪 / 少数派 / 新浪滚动热点，AI 生成候选后勾选一键批量发题。素材同时保留，便于人工选题。</view>
    <view wx:if="{{autoLoading}}" class="auto-empty">加载中...</view>
    <view wx:elif="{{autoDays.length === 0}}" class="auto-empty">暂无定时候选（定时任务首次运行后出现，或见运行日志）</view>

    <block wx:for="{{autoDays}}" wx:key="date" wx:for-item="day">
      <view class="auto-day">
        <view class="auto-day-head">
          <text class="auto-day-date">📅 {{day.date}}</text>
          <text class="auto-day-status {{day.items.length ? day.status : 'fail'}}">
            {{day.items.length ? (day.status === 'pending' ? '待确认' : day.status) : (day.aiError ? '生成失败' : '无候选')}}
          </text>
          <text class="auto-day-count" wx:if="{{day.items.length}}">{{day.items.length}} 条候选</text>
          <text class="auto-day-src" wx:if="{{day.aiMaterialSources.length}}">AI 素材源：{{day.aiMaterialSources}}</text>
        </view>
        <view wx:if="{{day.items.length === 0 && !day.aiError}}" class="auto-empty">AI 未生成候选</view>
        <view class="cand {{autoSelected[item.autoKey] ? 'picked' : ''}}"
          wx:for="{{day.items}}" wx:for-item="item" wx:key="autoKey"
          data-key="{{item.autoKey}}" bindtap="onAutoToggle">
          <view class="cand-check">{{autoSelected[item.autoKey] ? '✅' : '⬜'}}</view>
          <view class="cand-body">
            <view class="cand-title">{{item.title}}</view>
            <view class="cand-tags">
              <text class="cand-tag">{{item.category}}</text>
              <text class="cand-tag {{item.verifiable ? 'ok' : 'warn'}}">{{item.verifiable ? '可验证' : '需人工确认'}}</text>
              <text class="cand-tag" wx:if="{{item.dataSource}}">{{item.dataSource}}</text>
            </view>
            <view class="cand-reason">{{item.reason}}</view>
            <view class="cand-deadline" wx:if="{{item.suggestedDeadline}}">建议截止：{{item.suggestedDeadline}}</view>
          </view>
        </view>
        <!-- 详情/素材库折叠区：失败原因 + 新闻素材（人工选题参考） -->
        <view class="auto-news" wx:if="{{day.aiError || day.newsSummary}}" data-date="{{day.date}}" bindtap="onAutoToggleNews">
          <text>{{day.expanded ? '▾ 收起详情' : '▸ 查看详情'}}</text>
        </view>
        <view class="auto-detail" wx:if="{{day.expanded}}">
          <view class="auto-day-err" wx:if="{{day.aiError}}">⚠️ {{day.aiError}}</view>
          <view class="auto-summary" wx:if="{{day.newsSummary}}">📰 新闻素材库：{{day.newsSummary}}</view>
        </view>
      </view>
    </block>

    <view class="auto-ops" wx:if="{{autoDays.length}}">
      <button class="auto-select" bindtap="onAutoSelectAll">{{autoSelectAll ? '☑ 取消全选' : '☐ 全选'}}</button>
      <button class="auto-batch" bindtap="onAutoBatch">批量发题（{{autoBatchCount}}）</button>
    </view>
  </view>

  <view class="err-box" wx:if="{{errorMsg}}">
    <view class="err-title">⚠️ 出错了（完整信息）</view>
    <view class="err-text">{{errorMsg}}</view>
  </view>

  <view wx:if="{{generated && candidates.length === 0}}" class="empty">
    <view class="empty-icon">🤔</view>
    <view>没有候选事件，换个需求试试</view>
  </view>

  <view wx:elif="{{candidates.length > 0}}">
    <view class="mode-badge {{mode !== 'offline' ? 'online' : 'offline'}}">
      {{mode === 'qwen_search' ? '🔍 通义千问·联网模式' : mode === 'kimi_search' ? '🔍 Kimi·联网模式' : mode === 'deepseek_search' ? '🔍 DeepSeek·联网模式' : mode === 'custom_search' ? '🔍 自定义接口·联网模式' : mode === 'custom' ? '🔌 自定义接口（未开搜索）' : '📴 离线模式（联网不可用，已回退）'}}
    </view>
    <view class="fallback-reason" wx:if="{{mode === 'offline' && fallbackReason}}">
      回退原因：{{fallbackReason}}
    </view>
    <view class="cand card {{selected[item._id] ? 'picked' : ''}}"
      wx:for="{{candidates}}" wx:key="_id"
      data-id="{{item._id}}" bindtap="onToggle">
      <view class="cand-check">{{selected[item._id] ? '✅' : '⬜'}}</view>
      <view class="cand-body">
        <view class="cand-title">{{item.title}}</view>
        <view class="cand-tags">
          <text class="cand-tag">{{item.category}}</text>
          <text class="cand-tag {{item.verifiable ? 'ok' : 'warn'}}">{{item.verifiable ? '可验证' : '需人工确认'}}</text>
          <text class="cand-tag" wx:if="{{item.dataSource}}">{{item.dataSource}}</text>
        </view>
        <view class="cand-reason">{{item.reason}}</view>
        <view class="cand-deadline" wx:if="{{item.suggestedDeadline}}">建议截止：{{item.suggestedDeadline}}</view>
        <view class="cand-constraints" wx:if="{{item.constraintCheck}}">
          <text class="cand-check-item {{item.constraintCheck.binary ? 'ok' : 'bad'}}">二元</text>
          <text class="cand-check-item {{item.constraintCheck.singleSource ? 'ok' : 'bad'}}">单一源</text>
          <text class="cand-check-item {{item.constraintCheck.hardDeadline ? 'ok' : 'bad'}}">截止明确</text>
          <text class="cand-check-item {{item.constraintCheck.noSensitive ? 'ok' : 'bad'}}">无敏感</text>
          <text class="cand-check-item {{item.constraintCheck.hasSuspense ? 'ok' : 'bad'}}">有悬念</text>
          <text class="cand-prob" wx:if="{{item.probability}}">概率约 {{item.probability}}%</text>
        </view>
      </view>
    </view>

    <view class="op-row">
      <view class="select-all" bindtap="onSelectAll">{{selectAll ? '☑ 取消全选' : '☐ 全选'}}</view>
      <button class="again-btn" bindtap="onGenerate" disabled="{{generating}}">🔄 换一批</button>
    </view>

    <view class="bottom-bar">
      <view class="bottom-row">
        <button class="single-btn" bindtap="goPublish" disabled="{{generating}}">单个发题</button>
        <button class="batch-btn" bindtap="goBatch" disabled="{{generating}}">批量发题（{{selectedCount}}）</button>
      </view>
    </view>
  </view>
</view>
