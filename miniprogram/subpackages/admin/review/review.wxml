<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty-icon">✅</view>
    <view>队列已清空：没有待人工判定或昭示中的合约</view>
  </view>

  <view wx:else>
    <view class="review card" wx:for="{{list}}" wx:key="_id">
      <view class="r-top">
        <text class="r-cat">{{item.category}}</text>
        <text class="r-type {{item.reviewTypeCls}}">{{item.reviewTypeText}}</text>
      </view>
      <view class="r-title">{{item.title}}</view>
      <view class="r-meta">截止 {{item.deadlineText}}<text wx:if="{{item.expectedResultAtText}}"> · 预期结果 {{item.expectedResultAtText}}</text> · {{item.timeText}}</view>
      <view class="r-urgency {{item.urgencyCls}}" wx:if="{{item.urgencyText}}">{{item.urgencyText}}</view>
      <view class="r-result" wx:if="{{item.reviewType === 'dispute'}}">
        当前断卦：{{item.result === 'YES' ? '☰ 正' : '☷ 反'}}
      </view>

      <block wx:if="{{item.reviewType === 'manual_deadline' || item.reviewType === 'manual_fail'}}">
        <view class="evidence-row">
          <input
            class="evidence-input"
            placeholder="官方证据链接（选填，建议填写便于回溯）"
            data-id="{{item._id}}"
            bindinput="onEvidenceInput"
          />
        </view>
        <view class="op-row">
          <button class="op-btn yes" data-id="{{item._id}}" data-result="YES" bindtap="onResolve">断卦：☰ 正</button>
          <button class="op-btn no" data-id="{{item._id}}" data-result="NO" bindtap="onResolve">断卦：☷ 反</button>
        </view>
      </block>

      <block wx:else>
        <view class="op-tip">昭示期结束将自动结卦；以下按钮用于提前结卦或纠正断卦</view>
        <view class="op-row">
          <button class="op-btn" data-id="{{item._id}}" bindtap="onForceSettle">按当前断卦结卦</button>
        </view>
        <view class="op-row">
          <button class="op-btn yes" data-id="{{item._id}}" data-result="YES" bindtap="onOverride">覆盖为正方并结卦</button>
          <button class="op-btn no" data-id="{{item._id}}" data-result="NO" bindtap="onOverride">覆盖为反方并结卦</button>
        </view>
      </block>
    </view>
  </view>
</view>
