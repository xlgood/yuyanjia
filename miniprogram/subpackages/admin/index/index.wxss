.hero {
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #8e2a20, #c94a38);
  color: #ffffff;
  border-radius: 20rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 800;
}

.hero-sub {
  font-size: 22rpx;
  opacity: 0.82;
  margin-top: 8rpx;
}

.menu {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 22rpx;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d2926;
}

.menu-desc {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 6rpx;
}

.menu-badge {
  min-width: 48rpx;
  text-align: center;
  background: #faf0d7;
  color: #9c2f22;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.menu-badge.warn {
  background: #f6ded8;
  color: #c03a2b;
}

.menu-badge.urgent {
  background: #c03a2b;
  color: #ffffff;
}

.menu-arrow {
  color: #d8cfc0;
  font-size: 40rpx;
}

.footnote {
  text-align: center;
  font-size: 20rpx;
  color: #a39a8b;
  padding: 12rpx 40rpx 40rpx;
  line-height: 1.6;
}
