.container {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #efe6d3;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(146, 96, 24, 0.07);
}

.hero {
  background: linear-gradient(150deg, #8e2a20 0%, #b83a2c 60%, #c94a38 100%);
  color: #ffffff;
  text-align: center;
  padding: 44rpx 30rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(158, 47, 34, 0.3);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: #f8e3b0;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 246, 224, 0.85);
  margin-top: 10rpx;
}

.check-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #e0b64f, #c9a227);
  color: #5d4310;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 16rpx 0;
  line-height: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(180, 140, 40, 0.35);
}

.hero-tip {
  font-size: 22rpx;
  color: rgba(255, 246, 224, 0.7);
  margin-top: 16rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  margin: 26rpx 8rpx 14rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #9c2f22;
}

.sec-sub {
  font-size: 22rpx;
  color: #a39a8b;
  margin-left: 14rpx;
}

.item {
  display: flex;
  align-items: center;
}

.item.locked {
  opacity: 0.72;
  background: #f5f0e4;
}

.item.displayed {
  border: 3rpx solid #c9a227;
  background: #faf0d7;
}

.item-emoji {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #faf0d7;
  border: 1rpx solid #ecd9a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.item-emoji.gray {
  background: #f5f0e4;
  border-color: #e7dcc4;
  font-size: 34rpx;
}

.item-body {
  flex: 1;
}

.item-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #2d2926;
}

.item-desc {
  font-size: 23rpx;
  color: #8b8172;
  margin-top: 4rpx;
}

.item-rank-label {
  display: inline-block;
  font-size: 20rpx;
  color: #8c6a1c;
  background: #faf0d7;
  border: 1rpx solid #e4c87a;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-top: 8rpx;
}

.item-state {
  font-size: 23rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.item-state.done {
  color: #9c2f22;
  background: #fdf2f0;
}

.item-state.todo {
  color: #a39a8b;
  background: #f5f0e4;
}
