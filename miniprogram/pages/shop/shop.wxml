<view class="container">
  <view class="hero card">
    <view class="hero-title">🏅 我的卦勋墙</view>
    <view class="hero-sub">已解锁 {{unlockedCount}} / {{totalCount}} 项卦勋</view>
    <view class="hero-sub">点击已解锁的卦勋即可展示在个人页</view>
    <button class="check-btn" bindtap="onCheckHonors" disabled="{{checking}}">
      {{checking ? '检测中...' : '🔄 刷新卦勋检测'}}
    </button>
    <view class="hero-tip">达成目标自动解锁，无需兑换，永久保留</view>
  </view>

  <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="sec-head">
      <view class="sec-title">{{group.title}}</view>
      <view class="sec-sub">{{group.sub}}</view>
    </view>
    <view
      class="card item {{item.owned ? 'owned' : 'locked'}} {{item.displayed ? 'displayed' : ''}}"
      wx:for="{{group.items}}"
      wx:key="id"
      wx:for-item="item"
      data-id="{{item.id}}"
      bindtap="onSelectHonor"
    >
      <image wx:if="{{item.owned}}" class="item-emoji-img" src="/images/honor/{{item.id}}.png" mode="aspectFit"/>
      <view wx:else class="item-emoji gray">🔒</view>
      <view class="item-body">
        <view class="item-name">{{item.name}}</view>
        <view class="item-desc">{{item.desc}}</view>
        <view class="item-rank-label" wx:if="{{item.rankLabel}}">{{item.rankLabel}}</view>
      </view>
      <view class="item-state {{item.owned ? 'done' : 'todo'}}">{{item.owned ? (item.displayed ? '展示中' : '已解锁') : '未解锁'}}</view>
    </view>
  </block>

  <view class="footnote">卦勋为虚拟成就徽章，仅用于展示与社交炫耀，不消耗爻，无任何兑换现金或实物的价值。</view>
</view>
