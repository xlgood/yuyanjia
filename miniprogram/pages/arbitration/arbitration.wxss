.container {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #efe6d3;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(146, 96, 24, 0.07);
}

.head-card {
  background: linear-gradient(150deg, #8e2a20 0%, #b83a2c 60%, #c94a38 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(158, 47, 34, 0.3);
}

.head-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: #f8e3b0;
}

.head-status {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-top: 12rpx;
}

.head-status.pending { background: #e0b64f; color: #5d4310; }
.head-status.settled { background: rgba(255, 251, 240, 0.2); color: #f8e3b0; border: 1rpx solid rgba(224, 182, 79, 0.5); }

.head-time {
  font-size: 24rpx;
  color: rgba(255, 246, 224, 0.85);
  margin-top: 10rpx;
}

.head-market {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
  margin-top: 18rpx;
  color: #ffffff;
}

.head-rule {
  font-size: 22rpx;
  color: rgba(255, 246, 224, 0.75);
  margin-top: 12rpx;
}

.sec-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #9c2f22;
  margin-bottom: 16rpx;
}

.challenger-row {
  display: flex;
  align-items: center;
}

.challenger-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #faf0d7;
  border: 1rpx solid #ecd9a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
}

.challenger-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d2926;
}

.challenger-bond {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 4rpx;
}

.reason-box {
  background: #faf6ec;
  border: 1rpx solid #f0e7d2;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
}

.reason-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6f6552;
  margin-bottom: 6rpx;
}

.reason-text {
  font-size: 25rpx;
  color: #4a4238;
  line-height: 1.7;
}

/* 投票条：朱砂=支持，黛绿=否决 */
.vote-bar {
  display: flex;
  height: 20rpx;
  background: #dcebe3;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.vote-bar-support {
  height: 100%;
  background: linear-gradient(90deg, #d95a47, #c03a2b);
}

.vote-nums {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 600;
}

.vote-nums .green { color: #c03a2b; }
.vote-nums .red { color: #2e7d5b; }

.vote-min {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 12rpx;
  line-height: 1.6;
}

.bond-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.bond-label {
  font-size: 26rpx;
  color: #6f6552;
}

.bond-input {
  flex: 1;
  background: #faf6ec;
  border: 2rpx solid #e7dcc4;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  margin: 0 14rpx;
  font-size: 28rpx;
}

.bond-unit {
  font-size: 22rpx;
  color: #a39a8b;
}

.vote-btns {
  display: flex;
  gap: 20rpx;
}

.vote-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 0;
  line-height: 1.5;
}

.vote-btn.support {
  background: linear-gradient(135deg, #d95a47, #c03a2b);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(192, 58, 43, 0.3);
}

.vote-btn.oppose {
  background: linear-gradient(135deg, #3d9470, #2e7d5b);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 91, 0.3);
}

.eligibility {
  font-size: 22rpx;
  color: #a8801c;
  background: #faf0d7;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

.vote-rule {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 16rpx;
  line-height: 1.6;
}

.voted-line {
  font-size: 26rpx;
  color: #6f6552;
  line-height: 1.7;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #a39a8b;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
