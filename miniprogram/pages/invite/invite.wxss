.container {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #efe6d3;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(146, 96, 24, 0.07);
}

.hero-card {
  background: linear-gradient(150deg, #8e2a20 0%, #b83a2c 60%, #c94a38 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(158, 47, 34, 0.3);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: #f8e3b0;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: rgba(255, 246, 224, 0.85);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.reward-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.reward-box {
  background: rgba(255, 251, 240, 0.14);
  border: 1rpx solid rgba(224, 182, 79, 0.45);
  border-radius: 18rpx;
  padding: 20rpx 34rpx;
  text-align: center;
}

.reward-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #f8e3b0;
}

.reward-label {
  font-size: 22rpx;
  color: rgba(255, 246, 224, 0.85);
  margin-top: 6rpx;
}

.reward-arrow {
  margin: 0 24rpx;
  color: rgba(224, 182, 79, 0.7);
  font-size: 36rpx;
}

.share-main-btn {
  width: 100%;
  background: linear-gradient(135deg, #e0b64f, #c9a227);
  color: #5d4310;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(180, 140, 40, 0.35);
}

.btn-hover {
  opacity: 0.85;
}

.share-tip {
  font-size: 22rpx;
  color: rgba(255, 246, 224, 0.72);
  margin-top: 18rpx;
  line-height: 1.6;
}

.stat-card {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #9c2f22;
}

.stat-label {
  font-size: 24rpx;
  color: #8b8172;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #e7dcc4;
}

.list-head {
  font-size: 30rpx;
  font-weight: 700;
  color: #9c2f22;
  margin-bottom: 20rpx;
}

.list-empty {
  text-align: center;
  padding: 40rpx 0 20rpx;
  color: #a39a8b;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.invite-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0e9d9;
}

.invite-row:last-child {
  border-bottom: none;
}

.invite-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #faf0d7;
  border: 1rpx solid #ecd9a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.invite-info {
  flex: 1;
}

.invite-name {
  font-size: 28rpx;
  color: #33302a;
  font-weight: 500;
}

.invite-time {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 4rpx;
}

.invite-status {
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.invite-status.done {
  color: #9c2f22;
  background: #fdf2f0;
}

.invite-status.pending {
  color: #a8801c;
  background: #faf0d7;
}

.dev-card {
  background: #faf6ec;
  border: 2rpx dashed #c9a227;
}

.dev-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8c6a1c;
  margin-bottom: 10rpx;
}

.dev-tip {
  font-size: 24rpx;
  color: #a8801c;
  margin-bottom: 18rpx;
}

.dev-btn {
  background: #e4c87a;
  color: #5d4310;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rule-card {
  padding: 8rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.menu-icon {
  margin-right: 18rpx;
  font-size: 34rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #33302a;
}

.menu-arrow {
  color: #d8cfc0;
  font-size: 30rpx;
}
