<view class="container">
  <wxs src="../../utils/avatar.wxs" module="av"/>
  <view class="card profile-card">
    <view class="avatar-wrap" bindtap="onEditAvatar">
      <image wx:if="{{user && av.img(user.avatar)}}" class="avatar {{frameClass}}" src="{{av.img(user.avatar)}}" mode="aspectFill"/>
      <view wx:else class="avatar {{frameClass}}">{{user ? user.avatar : '🔮'}}</view>
      <view class="avatar-edit">更换</view>
    </view>
    <view class="p-info">
      <view class="p-name">
        {{user ? user.nickname : '未登录'}}
        <text class="p-title" wx:if="{{titleText}}">{{titleText}}</text>
      </view>
      <view class="p-edit">
        <text bindtap="onEditAvatar">更换头像</text>
        <text class="p-edit-sep">·</text>
        <text bindtap="onEditNickname">编辑雅号</text>
      </view>
    </view>
  </view>

  <block wx:if="{{!compliance}}">
    <view class="card stat-card">
      <view class="stat-item">
        <view class="stat-num">{{user ? user.points : '--'}}</view>
        <view class="stat-label">当前爻</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{user ? user.streak : '--'}}</view>
        <view class="stat-label">当前连胜</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{user ? user.bestStreak : '--'}}</view>
        <view class="stat-label">历史最高</view>
      </view>
    </view>

    <view class="card period-card">
      <view class="period-item">
        <text class="period-label">本周获得</text>
        <text class="period-val">{{user ? user.weekPoints : 0}}</text>
      </view>
      <view class="period-item">
        <text class="period-label">本月获得</text>
        <text class="period-val">{{user ? user.monthPoints : 0}}</text>
      </view>
      <view class="period-item">
        <text class="period-label">累计获得</text>
        <text class="period-val">{{user ? user.totalPoints : 0}}</text>
      </view>
    </view>

    <view class="card badges-card" wx:if="{{displayBadges.length}}">
      <view class="badges-label">我的卦勋</view>
      <view class="badges-row">
        <image class="badge-img" wx:for="{{displayBadges}}" wx:key="*this" wx:for-item="b" src="/images/honor/{{b}}.png" mode="aspectFit"/>
      </view>
    </view>
  </block>

  <view class="card menu-card">
    <view class="menu-item pk-toggle-row">
      <text class="menu-icon">⚔️</text>
      <text class="menu-text">允许卦友向我发起对弈</text>
      <switch checked="{{pkOpen}}" bindchange="onTogglePkOpen" color="#c03a2b" />
    </view>
    <view class="menu-item" bindtap="goPk">
      <text class="menu-icon">🛡️</text>
      <text class="menu-text">对弈弈台</text>
      <text class="menu-sub" wx:if="{{pkInboxCount > 0}}">{{pkInboxCount}} 个新邀弈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPkLeaderboard">
      <text class="menu-icon">🏆</text>
      <text class="menu-text">对弈胜率榜</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goArbitrationCenter">
      <text class="menu-icon">⚖️</text>
      <text class="menu-text">公断阁</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTask">
      <text class="menu-icon">🎁</text>
      <text class="menu-text">修习台（每日问签 / 看视频领爻）</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goShop">
      <text class="menu-icon">🛍️</text>
      <text class="menu-text">卦勋墙</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <text class="menu-icon">🛠️</text>
      <text class="menu-text">运营后台</text>
      <text class="menu-arrow">›</text>
    </view>
    <button class="menu-item menu-contact" open-type="contact">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </button>
    <view class="menu-item" bindtap="goHistory">
      <text class="menu-icon">📜</text>
      <text class="menu-text">我的卦录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onClaimRelief">
      <text class="menu-icon">🛟</text>
      <text class="menu-text">卦资救济（分享/看广告复活）</text>
      <text class="menu-sub" wx:if="{{user && user.points <= 0 && reliefLeft}}">{{reliefLeft}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goInvite">
      <text class="menu-icon">📣</text>
      <text class="menu-text">邀友参与，双方各得 {{invitePoints}} 爻</text>
      <text class="menu-sub" wx:if="{{inviteTotal > 0}}">已邀友 {{inviteTotal}} 人</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card rule-card" bindtap="onShowRules">
    <view class="menu-item">
      <text class="menu-icon">📖</text>
      <text class="menu-text">玩法与断卦规则</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footnote">
    爻为平台虚拟积分，仅用于参与卦题活动与兑换虚拟卦勋，不可兑换现金或实物。本应用内容仅供娱乐参考，不构成任何预测、投资或决策建议。
  </view>

  <view class="mask" wx:if="{{editVisible}}" bindtap="onCloseEdit">
    <view class="modal" catchtap="noop">
      <view class="modal-title">编辑雅号</view>
      <input
        class="modal-input"
        value="{{nicknameInput}}"
        bindinput="onNicknameInput"
        maxlength="{{nicknameMax}}"
        placeholder="输入新雅号（1-12 个字）"
      />
      <view class="modal-btns">
        <button class="modal-cancel" bindtap="onCloseEdit">取消</button>
        <button class="modal-ok" bindtap="onSaveNickname">保存</button>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{avatarVisible}}" bindtap="onCloseAvatar">
    <view class="modal" catchtap="noop">
      <view class="modal-title">选择头像</view>
      <view class="avatar-grid">
        <view
          wx:for="{{avatarOptions}}"
          wx:key="*this"
          class="avatar-option {{selectedAvatar === item ? 'active' : ''}}"
          data-avatar="{{item}}"
          bindtap="onPickAvatar"
        >
          <image wx:if="{{av.img(item)}}" class="avatar-option-img" src="{{av.img(item)}}" mode="aspectFit"/>
          <text wx:else>{{item}}</text>
        </view>
      </view>
      <view class="modal-btns">
        <button class="modal-cancel" bindtap="onCloseAvatar">取消</button>
        <button class="modal-ok" bindtap="onSaveAvatar">保存</button>
      </view>
    </view>
  </view>
</view>
