.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  margin-bottom: 24rpx;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #faf0d7;
  border: 2rpx solid #ecd9a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.avatar.frame-gold {
  border: 6rpx solid #c9a227;
}

.avatar.frame-flame {
  border: 6rpx solid #c03a2b;
  box-shadow: 0 0 16rpx rgba(192, 58, 43, 0.45);
}

.avatar.frame-star {
  border: 6rpx solid #7a5c9e;
  box-shadow: 0 0 16rpx rgba(122, 92, 158, 0.4);
}

.avatar-edit {
  position: absolute;
  left: 50%;
  bottom: -14rpx;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #c94a38, #b03224);
  color: #ffffff;
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.p-info {
  margin-left: 24rpx;
}

.p-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #2d2926;
}

.p-title {
  display: inline-block;
  background: linear-gradient(135deg, #e0b64f, #c9a227);
  color: #5d4310;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

.p-edit {
  font-size: 24rpx;
  color: #8b8172;
  margin-top: 8rpx;
}

.p-edit-sep {
  margin: 0 10rpx;
  color: #d8cfc0;
}

.stat-card {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #9c2f22;
}

.stat-label {
  font-size: 22rpx;
  color: #a39a8b;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e7dcc4;
}

.period-card {
  display: flex;
  justify-content: space-around;
  padding: 26rpx 0;
  margin-bottom: 24rpx;
}

.period-item {
  text-align: center;
}

.period-label {
  display: block;
  font-size: 22rpx;
  color: #a39a8b;
}

.period-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #2d2926;
  margin-top: 6rpx;
}

.badges-card {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}

.badges-label {
  font-size: 24rpx;
  color: #8b8172;
  margin-right: 20rpx;
  white-space: nowrap;
}

.badges-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.badge {
  font-size: 40rpx;
}

.menu-card {
  margin-bottom: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 28rpx 30rpx;
  background: transparent;
  border-radius: 0;
  text-align: left;
  font-size: 28rpx;
  color: #33302a;
  line-height: 1.5;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #f0e9d9;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
}

.menu-text {
  flex: 1;
}

.menu-sub {
  font-size: 22rpx;
  color: #c03a2b;
  margin-right: 12rpx;
}

.menu-arrow {
  color: #d8cfc0;
  font-size: 34rpx;
}

.pk-toggle-row {
  border-bottom: 2rpx solid #f0e9d9;
}

.rule-card {
  margin-bottom: 24rpx;
  overflow: hidden;
}

.modal-input {
  background: #faf6ec;
  border: 1rpx solid #e7dcc4;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  margin-bottom: 28rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.avatar-option {
  text-align: center;
  font-size: 52rpx;
  padding: 16rpx 0;
  background: #faf6ec;
  border: 3rpx solid transparent;
  border-radius: 14rpx;
}

.avatar-option.active {
  border-color: #c03a2b;
  background: #fdf2f0;
}

/* 图片版资源尺寸（PNG 接入） */
.badge-img { width: 56rpx; height: 56rpx; border-radius: 12rpx; }
.avatar-option-img { width: 52rpx; height: 52rpx; }
image.avatar { overflow: hidden; }
