<view class="container" wx:if="{{loading}}">
  <view class="loading">加载中...</view>
</view>

<view class="container" wx:elif="{{market}}">
  <view class="card main-card">
    <view class="d-header">
      <text class="d-cat">{{market.category}}</text>
      <text class="d-time">⏳ {{market.deadlineText}}</text>
      <button class="d-share-btn" open-type="share" data-channel="group">📣 分享</button>
    </view>
    <view class="d-title">{{market.title}}</view>

    <view class="rule-box">
      <view class="rule-title">📌 胜负断卦标准</view>
      <view class="rule-text">{{market.sourceOfTruth}}</view>
    </view>

    <view class="pool-box" wx:if="{{!compliance}}">
      <view class="pool-total">
        <text class="pool-total-label">当前卦池（双方附议爻总和）</text>
        <view class="pool-total-val">🪙 {{market.totalText}} <text class="pool-total-unit">爻</text></view>
      </view>
      <view class="rate-bar">
        <view class="rate-bar-yes" style="width: {{market.yesRateNum}}%"></view>
        <view class="rate-bar-no" style="width: {{market.noRateNum}}%"></view>
      </view>
      <view class="rate-legend">
        <text class="green">👍 {{market.yesRate}}</text>
        <text class="red">👎 {{market.noRate}}</text>
      </view>
      <view class="pool-participants">👥 {{participantCount}} 人参与应卦</view>
    </view>

    <view class="result-box" wx:if="{{market.status === 'resolved'}}">
      <view class="result-title">
        {{market.result === 'YES' ? '👍 官方断卦：看好成立' : '👎 官方断卦：不看好成立'}}
      </view>
      <view class="result-sub">断卦于 {{market.resolvedAtText}}，证据以断卦标准中指定数据源为准。</view>
      <view class="result-payout" wx:if="{{myBet}}">
        {{myBet.status === 'won' ? '🎉 应验！分卦获得 ' + myBet.payout + ' 爻' : myBet.status === 'lost' ? '本次未应验，爻已进入奖池' : myBet.status === 'refunded' ? '池数据异常，爻已原路退回' : ''}}
      </view>
    </view>

    <view class="dispute-banner" wx:if="{{market.status === 'dispute_window' || market.status === 'arbitration_window'}}">
      ⏳ 官方已录入断卦结果（{{market.result === 'YES' ? '看好' : '不看好'}}），
      {{market.status === 'arbitration_window' ? '正在公断公示期，社区附议决定是否推翻断卦' : '正在断卦公示期，可发起社区公断'}}。
    </view>
    <view class="dispute-banner" wx:if="{{market.status === 'locked'}}">
      ⏸ 已停止应卦，正在等待官方断卦，请留意结果公布。
    </view>
  </view>

  <!-- 审核模式：纯民意问卷 -->
  <view class="card action-card" wx:if="{{compliance}}">
    <view class="action-title">今日热点民意调查</view>
    <view class="poll-tip">您的选择仅作为民意统计，不消耗任何爻，不影响任何奖励。</view>
    <view class="choice-row">
      <view
        class="choice-btn poll {{pollChoice === 'YES' ? 'selected-yes' : ''}}"
        data-choice="YES"
        bindtap="onPollVote"
      >👍 看好</view>
      <view
        class="choice-btn poll {{pollChoice === 'NO' ? 'selected-no' : ''}}"
        data-choice="NO"
        bindtap="onPollVote"
      >👎 不看好</view>
    </view>
    <view class="poll-done" wx:if="{{pollChoice}}">
      感谢参与！您已选择：{{pollChoice === 'YES' ? '看好' : '不看好'}}
    </view>
  </view>

  <!-- 完整模式：爻应卦 -->
  <view class="card action-card" wx:elif="{{market.status === 'open' && !myBet}}">
    <view class="action-title">您的判断是？</view>
    <view class="choice-row">
      <view
        class="choice-btn {{selectedChoice === 'YES' ? 'selected-yes' : ''}}"
        data-choice="YES"
        bindtap="onSelectChoice"
      >👍 看好</view>
      <view
        class="choice-btn {{selectedChoice === 'NO' ? 'selected-no' : ''}}"
        data-choice="NO"
        bindtap="onSelectChoice"
      >👎 不看好</view>
    </view>

    <block wx:if="{{selectedChoice}}">
      <view class="amount-tip">选择附议的爻（多档可选）</view>
      <view class="amount-grid">
        <view
          wx:for="{{presets}}"
          wx:key="*this"
          class="amount-btn {{selectedAmount === item && !customAmount ? 'active' : ''}}"
          data-amount="{{item}}"
          bindtap="onSelectAmount"
        >{{item}}</view>
      </view>
      <view class="custom-row">
        <text class="custom-label">自定义</text>
        <input
          class="custom-input"
          type="number"
          placeholder="输入任意爻"
          value="{{customAmount}}"
          bindinput="onCustomAmount"
        />
      </view>
      <view class="my-balance">我的爻：{{userPoints}}</view>
      <button class="primary-btn confirm-btn" bindtap="onConfirmBet" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '确认附议 ' + (selectedAmount || 0) + ' 爻'}}
      </button>
      <button class="pk-btn" bindtap="onCreatePk" disabled="{{submitting}}">
        <view class="pk-btn-title">⚔️ 发起 对弈 邀弈</view>
        <view class="pk-btn-sub">邀友论卦应弈，双方立场相反</view>
      </button>
    </block>
  </view>

  <!-- 已锁定：等待断卦 -->
  <view class="card action-card" wx:elif="{{market.status === 'locked' && !myBet}}">
    <view class="action-title">⏸ 已停止应卦</view>
    <view class="poll-tip">该事件已到截止时间，正在等待官方断卦；结果确认并公示后将自动结卦。</view>
  </view>

  <!-- 已应卦状态 -->
  <view class="card action-card voted-card" wx:elif="{{myBet}}">
    <view class="voted-title">✅ 您已加入卦题</view>
    <view class="voted-line">
      您附议了 <text class="{{myBet.choice === 'YES' ? 'green' : 'red'}}">{{myBet.choice === 'YES' ? '看好 (YES)' : '不看好 (NO)'}}</text>
    </view>
    <view class="voted-line">投入 {{myBet.amount}} 爻</view>
    <view class="voted-wait" wx:if="{{market.status === 'open'}}">⏳ 池内数据在截止前仍会变动，请等待官方断卦。</view>
    <view class="voted-wait" wx:elif="{{market.status === 'locked'}}">⏸ 已停止应卦，等待官方断卦中。</view>
    <view class="voted-payout" wx:if="{{myBet.status === 'won'}}">🎉 应验，分卦获得 {{myBet.payout}} 爻！</view>
    <view class="voted-payout lost" wx:if="{{myBet.status === 'lost'}}">本次未应验，投入爻已进入奖池。</view>
    <view class="voted-payout" wx:if="{{myBet.status === 'refunded'}}">池数据异常，爻已原路退回。</view>
  </view>

  <!-- 公断入口 -->
  <view class="card arbitration-card" wx:if="{{market.status === 'dispute_window' && myBet}}">
    <view class="action-title">⚖️ 对断卦结果有异议？</view>
    <view class="arb-tip">
      <block wx:if="{{participantCount < 10}}">该事件应卦人数 {{participantCount}} 人，不足 10 人，暂反对社区公断。</block>
      <block wx:elif="{{activeArbitration}}">该事件已有进行中的公断，点击进入公断阁查看附议进展。</block>
      <block wx:else>发起公断需锁定当前全部爻作为保证金，公示 24 小时由社区附议决定是否推翻断卦。</block>
    </view>
    <button
      class="primary-btn"
      bindtap="onArbitrationAction"
      disabled="{{!isMock && participantCount < 10}}"
    >{{activeArbitration ? '查看公断进展' : '发起社区公断'}}</button>
  </view>

  <!-- 发起公断确认面板 -->
  <view class="mask" wx:if="{{arbConfirmVisible}}" bindtap="onArbCancel">
    <view class="modal arb-confirm" catchtap="noop">
      <view class="modal-title">⚖️ 确认发起公断</view>
      <view class="arb-confirm-tip">发起公断需将当前全部爻作为保证金锁定，公示期结束后按附议结果分配。</view>
      <view class="arb-confirm-bond">
        <view class="arb-bond-label">本次锁定保证金</view>
        <view class="arb-bond-num">🪙 {{arbBond}} 爻（当前全部）</view>
      </view>
      <view class="arb-confirm-rule">
        公断成立 → 断卦翻转，投对票者分卦对方保证金；<br/>
        公断不成立 → 维持原断卦，你的保证金归反对方。<br/>
        公示期 24 小时，一旦发起不可撤回。
      </view>
      <view class="arb-reason-box">
        <view class="arb-reason-label">公断理由（必填，10-200 字）</view>
        <textarea
          class="arb-reason-input"
          placeholder="说明为什么认为当前断卦有误（如：官方数据源口径、截止时点等）"
          value="{{arbReason}}"
          bindinput="onArbReasonInput"
          maxlength="200"
          auto-height
        />
      </view>
      <view class="modal-btns">
        <button class="modal-cancel" bindtap="onArbCancel">再想想</button>
        <button class="modal-ok" bindtap="onArbConfirm" disabled="{{submitting}}">确认发起</button>
      </view>
    </view>
  </view>

  <!-- 爻不足引导面板 -->
  <view class="mask" wx:if="{{insufficientVisible}}" bindtap="onCloseInsufficient">
    <view class="modal insuff-confirm" catchtap="noop">
      <view class="modal-title">🪙 爻不足</view>
      <view class="insuff-tip">
        本次应卦需要 <text class="insuff-need">{{needAmount}}</text> 爻，
        当前拥有 <text class="insuff-have">{{userPoints}}</text> 爻，还差 <text class="insuff-gap">{{needAmount - userPoints > 0 ? needAmount - userPoints : 0}}</text> 爻。
      </view>
      <view class="insuff-ways">
        <view class="way-row">📅 每日问签，连续问签奖励递增</view>
        <view class="way-row">📺 看视频领爻，每天最多 3 次</view>
        <view class="way-row">🛟 爻归零时还可领取卦资救济</view>
      </view>
      <view class="modal-btns">
        <button class="modal-cancel" bindtap="onCloseInsufficient">暂不应卦</button>
        <button class="modal-ok" bindtap="goTaskCenter">去修行台获取</button>
      </view>
    </view>
  </view>

  <view class="card arbitration-card" wx:if="{{market.status === 'arbitration_window'}}">
    <view class="action-title">⚖️ 公断进行中</view>
    <view class="arb-tip">社区正在附议决定是否推翻当前断卦（{{activeArbitration ? activeArbitration.supportVotes : 0}} 附议 / {{activeArbitration ? activeArbitration.opposeVotes : 0}} 反对）。</view>
    <button class="primary-btn" bindtap="goArbitration">进入公断阁</button>
  </view>

  <view class="card arbitration-card" wx:if="{{market.status === 'dispute_window' && arbitration && arbitration.status === 'settled'}}">
    <view class="action-title">⚖️ 公断已结束</view>
    <view class="arb-tip">
      {{arbitration.winner === 'support' ? '公断成立，断卦已翻转为' + (market.result === 'YES' ? '不看好' : '看好') : '公断未成立，维持原断卦'}}
    </view>
    <button class="primary-btn" bindtap="goArbitration">查看公断详情</button>
  </view>

  <!-- 本地 mock 模式专属：开发者模拟结卦面板 -->
  <view class="dev-card" wx:if="{{isMock && !compliance}}">
    <view class="dev-title">🛠️ 开发者模拟结卦（本地测试）</view>
    <view wx:if="{{market.status === 'open'}}">
      <view class="dev-row">
        <button class="dev-btn yes" data-result="YES" bindtap="onDevResolve">模拟断卦 YES（进公示期）</button>
        <button class="dev-btn no" data-result="NO" bindtap="onDevResolve">模拟断卦 NO（进公示期）</button>
      </view>
    </view>
    <view wx:elif="{{market.status === 'dispute_window'}}">
      <button class="dev-btn" bindtap="onDevSettle">模拟结卦（分卦）</button>
      <button class="dev-btn" bindtap="onDevForceSettle">强制结卦（跳过公示/公断）</button>
    </view>
    <view class="dev-tip">此面板仅在使用本地模拟数据时显示；接入云开发后，断卦与结卦由管理员后台操作。</view>
  </view>
</view>

<view class="container" wx:else>
  <view class="empty">
    <view class="empty-icon">🔍</view>
    <view>卦题不存在或已被移除</view>
  </view>
</view>
