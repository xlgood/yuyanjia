.container {
  padding: 24rpx 24rpx 60rpx;
}

.tab-bar {
  display: flex;
  background: #fffdf8;
  border: 1rpx solid #efe6d3;
  border-radius: 18rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8b8172;
  padding: 16rpx 0;
  border-radius: 12rpx;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, #c94a38, #b03224);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(176, 50, 36, 0.25);
}

.tab-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  background: #c03a2b;
  color: #fff;
  font-size: 20rpx;
  margin-left: 6rpx;
  text-align: center;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #efe6d3;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(146, 96, 24, 0.07);
}

.pk-card.highlight {
  border: 3rpx solid #c9a227;
}

.pk-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.pk-vs {
  display: flex;
  align-items: center;
}

.pk-user {
  text-align: center;
}

.pk-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #faf0d7;
  border: 1rpx solid #ecd9a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.pk-name {
  font-size: 22rpx;
  color: #6f6552;
  margin-top: 6rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pk-vs-text {
  font-size: 30rpx;
  font-weight: 900;
  color: #c03a2b;
  margin: 0 24rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.pk-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.pk-status.pending { color: #a8801c; background: #faf0d7; }
.pk-status.accepted { color: #8c6a1c; background: #f8e9c4; }
.pk-status.declined { color: #8b8172; background: #f5f0e4; }
.pk-status.expired { color: #8b8172; background: #f5f0e4; }
.pk-status.settled { color: #9c2f22; background: #fdf2f0; }

.pk-expires {
  font-size: 22rpx;
  color: #a8801c;
}

.pk-market {
  font-size: 28rpx;
  color: #2d2926;
  font-weight: 600;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.pk-stance {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stance-chip {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.stance-chip.yes { background: #fdf2f0; color: #c03a2b; }
.stance-chip.no { background: #e9f3ee; color: #2e7d5b; }

.stance-amount {
  font-size: 24rpx;
  color: #6f6552;
}

.stance-reverse {
  font-size: 22rpx;
  color: #a39a8b;
  width: 100%;
}

.pk-actions {
  display: flex;
  gap: 20rpx;
}

.pk-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 0;
  line-height: 1.5;
}

.pk-btn.decline {
  background: #f3ecdd;
  color: #6f6552;
}

.pk-btn.accept {
  background: linear-gradient(135deg, #c94a38, #b03224);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(176, 50, 36, 0.28);
}

.pk-result {
  font-size: 26rpx;
  font-weight: 700;
  color: #9c2f22;
  background: #fdf2f0;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #a39a8b;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #b7ad9c;
  margin-top: 10rpx;
}

.dev-card {
  background: #faf6ec;
  border: 2rpx dashed #c9a227;
}

.dev-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8c6a1c;
  margin-bottom: 10rpx;
}

.dev-tip {
  font-size: 24rpx;
  color: #a8801c;
  margin-bottom: 18rpx;
}

.dev-btn {
  background: #e4c87a;
  color: #5d4310;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.load-more {
  text-align: center;
  color: #c03a2b;
  font-size: 26rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.list-end {
  text-align: center;
  color: #a39a8b;
  font-size: 22rpx;
  padding: 24rpx 0;
}
